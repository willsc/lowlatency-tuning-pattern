#!/usr/bin/env python3
"""
lltune - low-latency core plan / boot config / runtime tuning for AWS metal.

Layers, in the order they must be applied:

  1. plan      : decide which physical core does what (pure computation, no side effects)
  2. boot      : GRUB cmdline  - isolcpus / nohz_full / rcu_nocbs / nosmt / numa_balancing  (needs reboot)
  3. cgroup    : systemd slices - system.slice, irqnet.slice, pulsar.slice
  4. runtime   : IRQ affinity, ENA queues, workqueues, governor, THP  (every boot)
  5. validate  : prove all four actually took effect

The plan is the single source of truth. Everything else is rendered from it, so
boot args, cgroups, IRQ pinning and the app's core lists can never drift apart.
"""

import argparse, json, os, re, subprocess, sys, glob
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
STATE = Path("/etc/lowlatency")
PLAN_PATH = STATE / "plan.json"

# ---------------------------------------------------------------- cpu list utils

def compress(cpus):
    """[0,1,2,5,7,8] -> '0-2,5,7-8'"""
    cpus = sorted(set(int(c) for c in cpus))
    if not cpus:
        return ""
    out, start, prev = [], cpus[0], cpus[0]
    for c in cpus[1:]:
        if c == prev + 1:
            prev = c
            continue
        out.append(f"{start}-{prev}" if start != prev else f"{start}")
        start = prev = c
    out.append(f"{start}-{prev}" if start != prev else f"{start}")
    return ",".join(out)


def expand(spec):
    """'0-2,5' -> [0,1,2,5]"""
    cpus = []
    for part in str(spec).split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-", 1)
            cpus.extend(range(int(a), int(b) + 1))
        else:
            cpus.append(int(part))
    return sorted(set(cpus))


# ---------------------------------------------------------------- topology

def topology_from_profile(profile):
    """Synthesise the EC2 metal CPU enumeration from a profile descriptor.

    EC2 numbers primary threads 0..(cores-1) socket by socket, then every sibling
    thread in the same order: on a 2s x 24c x 2t host node0 is 0-23,48-71.
    """
    s = profile["sockets"]
    cps = profile["cores_per_socket"]
    tpc = profile["threads_per_core"]
    nodes = profile["numa_nodes"]
    l3 = profile.get("cores_per_l3", cps)
    total = s * cps
    if total % nodes:
        raise SystemExit(f"{profile['name']}: {total} cores does not divide into {nodes} NUMA nodes")
    per_node = total // nodes

    cores = []
    for i in range(total):
        threads = [i] + [i + total * t for t in range(1, tpc)]
        cores.append({
            "core": i,
            "socket": i // cps,
            "node": i // per_node,
            "l3": i // l3,
            "threads": threads,
        })
    return {
        "source": "profile:" + profile["name"],
        "vendor": profile["vendor"],
        "sockets": s,
        "numa_nodes": nodes,
        "threads_per_core": tpc,
        "total_cores": total,
        "total_cpus": total * tpc,
        "cores_per_l3": l3,
        "nic_numa_node": profile.get("nic_numa_node", 0),
        "nic_numa_node_source": "profile",
        "cores": cores,
    }


def _read(path, default=None):
    try:
        return Path(path).read_text().strip()
    except OSError:
        if default is None:
            raise
        return default


def topology_live():
    """Read the real topology out of sysfs. Authoritative; always prefer this on the host."""
    cpu_dirs = sorted(glob.glob("/sys/devices/system/cpu/cpu[0-9]*"),
                      key=lambda p: int(re.search(r"cpu(\d+)$", p).group(1)))
    by_core = {}
    for d in cpu_dirs:
        cpu = int(re.search(r"cpu(\d+)$", d).group(1))
        topo = Path(d) / "topology"
        if not topo.exists():
            continue  # offline cpu
        pkg = int(_read(topo / "physical_package_id", "0"))
        core_id = int(_read(topo / "core_id", "0"))
        node = 0
        for nd in glob.glob("/sys/devices/system/node/node[0-9]*"):
            if cpu in expand(_read(Path(nd) / "cpulist", "")):
                node = int(re.search(r"node(\d+)$", nd).group(1))
                break
        l3 = None
        for idx in glob.glob(f"{d}/cache/index*"):
            if _read(Path(idx) / "level", "") == "3":
                l3 = int(_read(Path(idx) / "id", "0"))
        key = (pkg, core_id)
        e = by_core.setdefault(key, {"socket": pkg, "node": node, "l3": l3, "threads": []})
        e["threads"].append(cpu)

    cores = []
    for i, (key, e) in enumerate(sorted(by_core.items(), key=lambda kv: min(kv[1]["threads"]))):
        e["threads"].sort()
        cores.append({"core": i, "socket": e["socket"], "node": e["node"],
                      "l3": e["l3"] if e["l3"] is not None else e["socket"],
                      "threads": e["threads"]})

    tpc = max(len(c["threads"]) for c in cores)
    l3_sizes = {}
    for c in cores:
        l3_sizes[c["l3"]] = l3_sizes.get(c["l3"], 0) + 1

    vendor = "amd" if "AMD" in _read("/proc/cpuinfo", "") else "intel"
    iface = primary_iface()
    nic_node, nic_src = nic_numa_node(iface)
    return {
        "source": "live",
        "vendor": vendor,
        "sockets": len({c["socket"] for c in cores}),
        "numa_nodes": len({c["node"] for c in cores}),
        "threads_per_core": tpc,
        "total_cores": len(cores),
        "total_cpus": sum(len(c["threads"]) for c in cores),
        "cores_per_l3": min(l3_sizes.values()) if l3_sizes else len(cores),
        "nic_numa_node": nic_node,
        "nic_numa_node_source": nic_src,
        "primary_iface": iface,
        "node_distance": node_distances_live(),
        "cores": cores,
    }


def nic_numa_node(iface=None):
    """(node, source). source is 'device' only when firmware actually said so.

    An ENA that reports -1 has no _PXM in the firmware tables. Falling back to node 0 is
    the only thing left to do, but it must not be mistaken for a measurement: on a
    multi-node host that fallback silently inverts the whole NIC-distance ranking.
    """
    iface = iface or primary_iface()
    if not iface:
        return 0, "no-interface"
    n = _read(f"/sys/class/net/{iface}/device/numa_node", "")
    try:
        val = int(n)
    except ValueError:
        return 0, "unreadable"
    return (val, "device") if val >= 0 else (0, "no-pxm")


def primary_iface():
    for p in sorted(glob.glob("/sys/class/net/*")):
        name = os.path.basename(p)
        if name == "lo" or not os.path.exists(f"{p}/device"):
            continue
        return name
    return None


def node_distances_live():
    """The ACPI SLIT, as the kernel exposes it: {node: {node: distance}}."""
    out = {}
    for nd in glob.glob("/sys/devices/system/node/node[0-9]*"):
        n = int(re.search(r"node(\d+)$", nd).group(1))
        row = _read(Path(nd) / "distance", "")
        if row:
            out[n] = {i: int(v) for i, v in enumerate(row.split())}
    return out


# ---------------------------------------------------------------- nic locality

def node_socket_map(topo):
    m = {}
    for c in topo["cores"]:
        m.setdefault(c["node"], c["socket"])
    return m


def _tier_label(tier, members, nic, sock):
    if tier == 0:
        return "NIC-local"
    same = all(sock.get(n) == sock.get(nic) for n in members)
    return "same socket, remote die" if same else "remote socket"


def build_nic_locality(topo, distances=None):
    """Rank every NUMA node by how close it is to the primary NIC.

    Tier 0 is the NIC's own node, tier 1 the next-closest set, and so on. The exclusive
    cores on tier 0 are the ones worth spending first: no amount of core isolation buys
    back a die crossing or a UPI hop on every packet descriptor and DMA buffer touch.

    On a live host the ranking is the real ACPI SLIT. A profile has no SLIT to read, so
    it falls back to the structural model - own node, then the rest of the same socket
    nearest-die first, then the other socket. That model is an inference, and the
    `source` field says so; `lltune nic --live` is what settles it on first contact.
    """
    nodes = sorted({c["node"] for c in topo["cores"]})
    nic = topo.get("nic_numa_node", 0)
    if nic not in nodes:
        nic = nodes[0]
    sock = node_socket_map(topo)

    if distances and nic in distances:
        key = {n: distances[nic].get(n, 255) for n in nodes}
        source = "acpi-slit"
    else:
        # Sibling dies inside a socket sit at one SLIT distance from each other, so they
        # form a single tier; the other socket is one more hop behind whatever it holds.
        key = {}
        for n in nodes:
            if n == nic:
                key[n] = 0
            elif sock.get(n) == sock.get(nic):
                key[n] = 10
            else:
                key[n] = 100 + abs(sock.get(n, 0) - sock.get(nic, 0))
        source = "structural-model"

    # Within a tier, prefer the nearer node id: on SNC the die next to the NIC's die is
    # the better of two equal-distance choices even when the SLIT cannot say so.
    order = sorted(nodes, key=lambda n: (key[n], abs(n - nic), n))
    tiers = []
    for t, k in enumerate(sorted({key[n] for n in nodes})):
        members = [n for n in order if key[n] == k]
        tiers.append({
            "tier": t,
            "nodes": members,
            "distance": distances[nic][members[0]] if source == "acpi-slit" else None,
            "label": _tier_label(t, members, nic, sock),
        })
    node_source = topo.get("nic_numa_node_source", "profile")
    return {
        "nic_numa_node": nic,
        "nic_numa_node_source": node_source,
        "source": source,
        # Both halves have to be real for the ranking to be trustworthy: the SLIT says how
        # far the nodes are from each other, but it is worthless if the node we measured
        # from was a guess.
        "verified": (len(nodes) == 1
                     or (source == "acpi-slit" and node_source == "device")),
        "node_order": order,
        "tiers": tiers,
    }


# ---------------------------------------------------------------- planner

def clamp_count(n_cores, spec):
    return max(spec["min"], min(spec["max"], round(n_cores * spec["ratio"])))


def build_plan(topo, policy, profile_name=None):
    tpc = topo["threads_per_core"]
    smt_off = policy.get("smt", "off") == "off"
    # When SMT is disabled at boot the sibling threads never come online, so every
    # emitted list uses primary threads only. Handing offline CPUs to irqaffinity or
    # to a cpuset is how you get silent, confusing failures.
    def cpus_of(core):
        return [core["threads"][0]] if smt_off else list(core["threads"])

    nodes = sorted({c["node"] for c in topo["cores"]})
    locality = build_nic_locality(topo, topo.get("node_distance"))
    tier_of = {n: t["tier"] for t in locality["tiers"] for n in t["nodes"]}
    rank_of = {n: i for i, n in enumerate(locality["node_order"])}
    roles = {r: [] for r in ("housekeeping", "irqnet", "shared", "exclusive")}
    per_node = []

    for node in nodes:
        cores = sorted([c for c in topo["cores"] if c["node"] == node],
                       key=lambda c: (c["l3"], c["core"]))
        n = len(cores)
        hk = clamp_count(n, policy["housekeeping"])
        irq = clamp_count(n, policy["irqnet"])
        shared = max(1, round(n * policy["shared_ratio"]))
        non_iso = hk + irq + shared

        l3sz = topo.get("cores_per_l3", n)
        if policy.get("l3_align") and 0 < l3sz < n:
            # Round the non-isolated block up to a whole L3/CCX domain: an exclusive
            # core must never share last-level cache with housekeeping or IRQ work.
            aligned = -(-non_iso // l3sz) * l3sz
            if aligned <= n * (1 - policy["min_exclusive_ratio"]):
                shared += aligned - non_iso
                non_iso = aligned

        max_non_iso = int(n * (1 - policy["min_exclusive_ratio"]))
        if non_iso > max_non_iso:
            raise SystemExit(
                f"node{node}: policy wants {non_iso}/{n} non-isolated cores, "
                f"min_exclusive_ratio={policy['min_exclusive_ratio']} allows {max_non_iso}. "
                f"Lower shared_ratio or min_exclusive_ratio.")

        cuts = {"housekeeping": cores[:hk],
                "irqnet": cores[hk:hk + irq],
                "shared": cores[hk + irq:non_iso],
                "exclusive": cores[non_iso:]}

        entry = {"node": node, "cores_total": n,
                 "nic_tier": tier_of[node], "nic_rank": rank_of[node]}
        for role, sel in cuts.items():
            roles[role].extend(sel)
            cpus = [cpu for c in sel for cpu in cpus_of(c)]
            entry[role] = {"count": len(sel), "cpus": compress(cpus)}
        per_node.append(entry)

    if 0 not in [cpu for c in roles["housekeeping"] for cpu in cpus_of(c)]:
        raise SystemExit("cpu0 must be housekeeping; refusing plan (check core enumeration)")

    role_cpus = {r: sorted(cpu for c in cs for cpu in cpus_of(c)) for r, cs in roles.items()}
    isolated = role_cpus["exclusive"]
    non_isolated = sorted(role_cpus["housekeeping"] + role_cpus["irqnet"] + role_cpus["shared"])
    housekeeping_all = sorted(role_cpus["housekeeping"] + role_cpus["irqnet"])

    plan = {
        "version": 1,
        "profile": profile_name or topo["source"],
        "topology": {k: topo[k] for k in
                     ("source", "vendor", "sockets", "numa_nodes", "threads_per_core",
                      "total_cores", "total_cpus", "cores_per_l3", "nic_numa_node")},
        "policy": {k: v for k, v in policy.items() if not k.startswith(("_", "$"))},
        "nodes": per_node,
        "roles": {r: {"core_count": len(roles[r]), "cpu_count": len(role_cpus[r]),
                      "cpus": compress(role_cpus[r])} for r in roles},
        "nic_locality": locality,
        "isolated_cpus": compress(isolated),
        "non_isolated_cpus": compress(non_isolated),
        "irq_landing_cpus": compress(housekeeping_all),
        "memory_nodes": compress(nodes),
    }
    plan["cmdline"] = build_cmdline(plan, topo, policy)
    plan["app"] = build_app_contract(plan)
    return plan


def build_cmdline(plan, topo, policy):
    iso = plan["isolated_cpus"]
    args = []
    if policy.get("smt", "off") == "off" and topo["threads_per_core"] > 1:
        # nosmt is a no-op on AMD 7a-family (AWS ships those with SMT already off).
        args.append("nosmt=force")

    # --- isolation core ---
    args += [
        f"isolcpus=managed_irq,domain,{iso}",
        f"nohz_full={iso}",
        f"rcu_nocbs={iso}",
        f"irqaffinity={plan['irq_landing_cpus']}",
        "nohz=on",
    ]
    if policy.get("rcu_nocb_poll"):
        args.append("rcu_nocb_poll")

    # --- scheduler / NUMA ---
    args += ["numa_balancing=disable", "skew_tick=1"]

    # --- timers, watchdogs, noise ---
    args += ["nmi_watchdog=0", "nosoftlockup", "mce=ignore_ce",
             "tsc=reliable", "clocksource=tsc", "audit=0",
             "rcupdate.rcu_normal_after_boot=1"]

    # --- power / frequency determinism ---
    cmax = policy.get("cstate_max", 1)
    args.append(f"processor.max_cstate={cmax}")
    if topo["vendor"] == "intel":
        args.append(f"intel_idle.max_cstate={cmax}")
    args.append("cpufreq.default_governor=performance")
    if policy.get("idle_poll"):
        args.append("idle=poll")

    # --- memory ---
    args.append("transparent_hugepage=never")
    hp = policy.get("hugepages_1g_per_node", 0)
    if hp:
        args += ["default_hugepagesz=1G", "hugepagesz=1G",
                 f"hugepages={hp * topo['numa_nodes']}"]

    # --- io / pci ---
    args += ["pcie_aspm=off", "iommu=pt"]

    # --- cgroup v2 for the slice layer ---
    args += ["systemd.unified_cgroup_hierarchy=1", "cgroup_no_v1=all"]

    if policy.get("mitigations_off"):
        args.append("mitigations=off")

    return " ".join(args)


def build_app_contract(plan):
    """What the application reads. exclusive_cores == isolated, shared_cores == non-isolated app pool.

    The flat lists are the whole pool. The *ranked* lists are the ones that decide latency:
    they hand back the same cores ordered by distance from the primary NIC, nearest first,
    so an application that cannot use every exclusive core spends the NIC-local ones first.
    """
    loc = plan["nic_locality"]
    by_node = {n["node"]: n for n in plan["nodes"]}
    app = {
        "exclusive_cores": plan["roles"]["exclusive"]["cpus"],
        "shared_cores": plan["roles"]["shared"]["cpus"],
        "exclusive_core_count": plan["roles"]["exclusive"]["cpu_count"],
        "shared_core_count": plan["roles"]["shared"]["cpu_count"],
        "nic_numa_node": loc["nic_numa_node"],
        "nic_locality_source": loc["source"],
        "nic_numa_node_source": loc["nic_numa_node_source"],
        "nic_locality_verified": loc["verified"],
        "numa_node_order": loc["node_order"],
        "per_node": {},
    }
    for n in plan["nodes"]:
        app["per_node"][str(n["node"])] = {
            "exclusive_cores": n["exclusive"]["cpus"],
            "shared_cores": n["shared"]["cpus"],
            "nic_tier": n["nic_tier"],
            "nic_rank": n["nic_rank"],
        }

    # Nearest-NIC-first: one entry per node, in preference order.
    app["exclusive_cores_ranked"] = [by_node[n]["exclusive"]["cpus"] for n in loc["node_order"]]
    app["shared_cores_ranked"] = [by_node[n]["shared"]["cpus"] for n in loc["node_order"]]

    # Collapsed to one entry per distance tier, which is what most apps actually shard on.
    excl_tier, shared_tier = {}, {}
    for t in loc["tiers"]:
        excl_tier[str(t["tier"])] = compress(
            [c for n in t["nodes"] for c in expand(by_node[n]["exclusive"]["cpus"])])
        shared_tier[str(t["tier"])] = compress(
            [c for n in t["nodes"] for c in expand(by_node[n]["shared"]["cpus"])])
    app["exclusive_cores_by_tier"] = excl_tier
    app["shared_cores_by_tier"] = shared_tier
    app["nic_local_exclusive_cores"] = excl_tier["0"]
    app["nic_local_exclusive_core_count"] = len(expand(excl_tier["0"]))
    return app


# ---------------------------------------------------------------- renderers

def render_grub(plan):
    return (
        "# Managed by lltune. Regenerate with: lltune render\n"
        "# Do not hand-edit; edit profiles/policy.json and re-render.\n"
        f'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT {plan["cmdline"]}"\n'
    )


SLICE_HEADER = "# Managed by lltune. Regenerate with: lltune render\n"


def render_slices(plan):
    hk = plan["roles"]["housekeeping"]["cpus"]
    irq = plan["roles"]["irqnet"]["cpus"]
    shared = plan["roles"]["shared"]["cpus"]
    excl = plan["roles"]["exclusive"]["cpus"]
    mem = plan["memory_nodes"]
    out = {}

    # system.slice carries housekeeping and nothing else. The shared cores are deliberately
    # in no cpuset at all: they are ordinary load-balanced CPUs with no kernel guarantee for
    # a cpuset to gate, and confining ordinary services to housekeeping keeps them off the
    # application's pool. A unit that needs the shared cores must therefore NOT sit under
    # system.slice - see docs/DESIGN.md section 4.
    out["system.slice.d/10-lowlatency.conf"] = (
        SLICE_HEADER +
        "[Slice]\n"
        f"# housekeeping = {hk}\n"
        f"# shared_cores = {shared}  (NOT granted here; no cpuset owns them)\n"
        f"AllowedCPUs={hk}\n"
        f"AllowedMemoryNodes={mem}\n"
    )

    # PID 1, login sessions and containers stay on housekeeping only - none of them should
    # drift onto the application's shared pool.
    for unit in ("user.slice", "machine.slice", "init.scope"):
        out[f"{unit}.d/10-lowlatency.conf"] = (
            SLICE_HEADER +
            f"[{'Scope' if unit.endswith('.scope') else 'Slice'}]\n"
            f"AllowedCPUs={hk}\n"
            f"AllowedMemoryNodes={mem}\n"
        )

    out["irqnet.slice"] = (
        SLICE_HEADER +
        "[Unit]\n"
        "Description=IRQ handling, softirq and NIC housekeeping\n"
        "Before=slices.target\n\n"
        "[Slice]\n"
        f"AllowedCPUs={irq}\n"
        f"AllowedMemoryNodes={mem}\n"
        "CPUAccounting=yes\n"
    )

    # The application slice holds the isolated cores and nothing else. The cpuset exists
    # to gate access to isolcpus'd CPUs, which is a real guarantee; the shared cores are
    # ordinary load-balanced CPUs with no guarantee for a cpuset to enforce, so no slice
    # names them. See docs/DESIGN.md section 4 for how a unit reaches them instead.
    out["pulsar.slice"] = (
        SLICE_HEADER +
        "[Unit]\n"
        "Description=Pulsar exclusive_cores - isolated, no load balancing, no tick\n"
        "Before=slices.target\n\n"
        "[Slice]\n"
        f"# exclusive_cores (isolated) = {excl}\n"
        f"# shared_cores (in no cpuset, reached by inherited affinity) = {shared}\n"
        f"AllowedCPUs={excl}\n"
        f"AllowedMemoryNodes={mem}\n"
        "CPUAccounting=yes\n"
        "MemoryAccounting=yes\n"
        "# The latency path must never be reclaimed under pressure.\n"
        "MemorySwapMax=0\n"
    )
    return out


def render_cores_env(plan):
    a = plan["app"]
    lines = [
        "# Managed by lltune. Sourced by the application and by scripts/*.sh",
        f"LLTUNE_PROFILE={plan['profile']}",
        f"LLTUNE_VENDOR={plan['topology']['vendor']}",
        f"LLTUNE_NUMA_NODES={plan['topology']['numa_nodes']}",
        f"LLTUNE_SMT={plan['policy'].get('smt', 'off')}",
        "",
        "# --- application core contract ---",
        f"EXCLUSIVE_CORES={a['exclusive_cores']}",
        f"SHARED_CORES={a['shared_cores']}",
        f"EXCLUSIVE_CORE_COUNT={a['exclusive_core_count']}",
        f"SHARED_CORE_COUNT={a['shared_core_count']}",
        "",
        "# --- platform reserved ---",
        f"HOUSEKEEPING_CORES={plan['roles']['housekeeping']['cpus']}",
        f"IRQNET_CORES={plan['roles']['irqnet']['cpus']}",
        f"ISOLATED_CPUS={plan['isolated_cpus']}",
        f"NON_ISOLATED_CPUS={plan['non_isolated_cpus']}",
        "",
        "# --- NIC locality: nodes ranked by distance from the primary NIC, nearest first ---",
        f"NIC_NUMA_NODE={a['nic_numa_node']}",
        f"NIC_NUMA_NODE_SOURCE={a['nic_numa_node_source']}",
        f"NIC_LOCALITY_SOURCE={a['nic_locality_source']}",
        f"NIC_LOCALITY_VERIFIED={'yes' if a['nic_locality_verified'] else 'no'}",
        f"NUMA_NODE_ORDER={','.join(str(n) for n in a['numa_node_order'])}",
        f"NIC_LOCAL_EXCLUSIVE_CORES={a['nic_local_exclusive_cores']}",
        f"NIC_LOCAL_EXCLUSIVE_CORE_COUNT={a['nic_local_exclusive_core_count']}",
        "# Nearest-first, one field per node, '|' separated. Spend these left to right.",
        "# Quoted: an unquoted '|' would be a pipeline to a shell sourcing this file.",
        f"EXCLUSIVE_CORES_RANKED=\"{'|'.join(a['exclusive_cores_ranked'])}\"",
        f"SHARED_CORES_RANKED=\"{'|'.join(a['shared_cores_ranked'])}\"",
        "",
        "# --- per NIC distance tier ---",
    ]
    for tier in sorted(a["exclusive_cores_by_tier"], key=int):
        lines.append(f"EXCLUSIVE_CORES_TIER{tier}={a['exclusive_cores_by_tier'][tier]}")
        lines.append(f"SHARED_CORES_TIER{tier}={a['shared_cores_by_tier'][tier]}")
    lines += ["", "# --- per NUMA node ---"]
    for node, v in sorted(a["per_node"].items(), key=lambda kv: int(kv[0])):
        lines.append(f"EXCLUSIVE_CORES_NODE{node}={v['exclusive_cores']}")
        lines.append(f"SHARED_CORES_NODE{node}={v['shared_cores']}")
        lines.append(f"NIC_TIER_NODE{node}={v['nic_tier']}")
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------- commands

def load_policy(path=None):
    p = Path(path) if path else REPO / "profiles" / "policy.json"
    return json.loads(p.read_text())


def load_profile(name):
    p = Path(name)
    if not p.exists():
        p = REPO / "profiles" / f"{name}.json"
    if not p.exists():
        avail = ", ".join(sorted(f.stem for f in (REPO / "profiles").glob("*.json") if f.stem != "policy"))
        raise SystemExit(f"unknown profile '{name}'. Available: {avail}")
    return json.loads(p.read_text())


def get_topology(args):
    if args.live:
        return topology_live(), "live"
    if not args.profile:
        raise SystemExit("pass --live to read this host, or --profile <name> to plan a shape")
    prof = load_profile(args.profile)
    return topology_from_profile(prof), prof["name"]


def cmd_topology(args):
    topo, _ = get_topology(args)
    print(json.dumps(topo if args.verbose else
                     {k: v for k, v in topo.items() if k != "cores"}, indent=2))


def cmd_plan(args):
    topo, name = get_topology(args)
    policy = load_policy(args.policy)
    for k, v in (("shared_ratio", args.shared_ratio),
                 ("mitigations_off", args.mitigations_off),
                 ("idle_poll", args.idle_poll),
                 ("hugepages_1g_per_node", args.hugepages_1g_per_node)):
        if v is not None:
            policy[k] = v
    plan = build_plan(topo, policy, name)
    text = json.dumps(plan, indent=2)
    if args.out:
        Path(args.out).write_text(text + "\n")
        print(f"wrote {args.out}", file=sys.stderr)
    else:
        print(text)


def plan_for(args):
    """--plan file wins, then a live/profile computation, then the installed plan."""
    if getattr(args, "plan", None):
        return json.loads(Path(args.plan).read_text())
    if getattr(args, "profile", None) or getattr(args, "live", False):
        topo, name = get_topology(args)
        return build_plan(topo, load_policy(getattr(args, "policy", None)), name)
    return current_plan()


def cmd_show(args):
    plan = plan_for(args)
    t = plan["topology"]
    print(f"profile   : {plan['profile']}  ({t['vendor']}, {t['sockets']}s x "
          f"{t['total_cores'] // t['sockets']}c, {t['numa_nodes']} NUMA node(s), "
          f"SMT {plan['policy'].get('smt')})")
    print(f"cores     : {t['total_cores']} physical / {t['total_cpus']} logical "
          f"-> {plan['roles']['exclusive']['cpu_count'] + plan['roles']['shared']['cpu_count'] + plan['roles']['housekeeping']['cpu_count'] + plan['roles']['irqnet']['cpu_count']} usable after SMT policy")
    print()
    hdr = (f"{'node':>4} {'tier':>5}  {'housekeeping':>26}  {'irqnet':>22}  "
           f"{'shared':>26}  {'exclusive':>30}")
    print(hdr)
    print("-" * len(hdr))
    for n in plan["nodes"]:
        tier = n.get("nic_tier", "-")
        print(f"{n['node']:>4} {tier:>5}  {n['housekeeping']['cpus']:>26}  "
              f"{n['irqnet']['cpus']:>22}  {n['shared']['cpus']:>26}  {n['exclusive']['cpus']:>30}")
    print()
    print_nic_locality(plan)
    for r in ("housekeeping", "irqnet", "shared", "exclusive"):
        v = plan["roles"][r]
        pct = 100.0 * v["cpu_count"] / max(1, sum(plan["roles"][x]["cpu_count"] for x in plan["roles"]))
        print(f"  {r:<13} {v['cpu_count']:>4} cpu  ({pct:5.1f}%)  {v['cpus']}")
    print()
    print(f"  exclusive_cores (app) = {plan['app']['exclusive_cores']}")
    print(f"  shared_cores    (app) = {plan['app']['shared_cores']}")
    if "nic_local_exclusive_cores" in plan["app"]:
        print(f"  NIC-local exclusive   = {plan['app']['nic_local_exclusive_cores']} "
              f"({plan['app']['nic_local_exclusive_core_count']} cpu) <- spend these first")
    print()
    print("cmdline:")
    for a in plan["cmdline"].split():
        print(f"  {a}")


def cmd_render(args):
    plan = plan_for(args)
    out = Path(args.out)
    (out / "grub").mkdir(parents=True, exist_ok=True)
    (out / "systemd").mkdir(parents=True, exist_ok=True)

    (out / "grub" / "99-lowlatency.cfg").write_text(render_grub(plan))
    for rel, body in render_slices(plan).items():
        dest = out / "systemd" / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(body)
    (out / "cores.env").write_text(render_cores_env(plan))
    (out / "lowlatency-pulsar-variables.conf").write_text(
        "# Managed by lltune. Install to /etc/tuned/lowlatency-pulsar-variables.conf\n"
        f"isolated_cores={plan['isolated_cpus']}\n"
        f"housekeeping_cores={plan['irq_landing_cpus']}\n"
        f"shared_cores={plan['roles']['shared']['cpus']}\n")
    (out / "plan.json").write_text(json.dumps(plan, indent=2) + "\n")
    print(f"rendered into {out}")


def cmd_layers(args):
    """Dump every configuration layer for a profile, in the order it is applied."""
    plan = plan_for(args)
    t = plan["topology"]
    out = {
        "profile": plan["profile"],
        "topology": t,
        "roles": plan["roles"],
        "nodes": plan["nodes"],
        "layers": {
            "1_boot_grub": {
                "file": "/etc/default/grub.d/99-lowlatency.cfg",
                "applies": "at boot, requires reboot",
                "cmdline": plan["cmdline"],
                "args": plan["cmdline"].split(),
            },
            "2_cgroup_slices": {
                "applies": "systemctl daemon-reload, immediate",
                "units": {name: body for name, body in render_slices(plan).items()},
            },
            "3_runtime": {
                "file": "scripts/apply-runtime.sh",
                "applies": "every boot via lltune-runtime.service",
                "irq_landing_cpus": plan["irq_landing_cpus"],
                "ena_combined_queues": len(expand(plan["roles"]["irqnet"]["cpus"])),
                "workqueue_cpumask": plan["non_isolated_cpus"],
                "xps_source_cpus": plan["roles"]["exclusive"]["cpus"],
            },
            "4_app_contract": {
                "file": "/etc/lowlatency/cores.env",
                "nic_numa_node": plan.get("nic_locality", {}).get("nic_numa_node"),
                "numa_node_order": plan.get("nic_locality", {}).get("node_order"),
                "env": render_cores_env(plan),
            },
        },
    }
    if args.json:
        print(json.dumps(out, indent=2))
        return

    bar = "=" * 78
    print(bar)
    print(f"{plan['profile']}   {t['vendor']}  {t['sockets']}s x "
          f"{t['total_cores'] // t['sockets']}c  |  {t['numa_nodes']} NUMA node(s)  |  "
          f"SMT {plan['policy'].get('smt')}  |  L3 domain {t['cores_per_l3']} cores")
    print(bar)
    print()
    print_nic_locality(plan)
    print("--- LAYER 1: GRUB (boot, needs reboot) "
          "-> /etc/default/grub.d/99-lowlatency.cfg\n")
    for a in plan["cmdline"].split():
        print(f"    {a}")
    print("\n--- LAYER 2: cgroup slices (immediate) -> /etc/systemd/system/\n")
    for name, body in render_slices(plan).items():
        cpus = re.search(r"AllowedCPUs=(\S+)", body).group(1)
        print(f"    {name:<38} AllowedCPUs={cpus}")
    print("\n--- LAYER 3: runtime (every boot) -> lltune-runtime.service\n")
    r = out["layers"]["3_runtime"]
    print(f"    IRQ affinity            {r['irq_landing_cpus']}")
    print(f"    ENA combined queues     {r['ena_combined_queues']}  (clamped to irqnet core count)")
    print(f"    workqueue cpumask       {r['workqueue_cpumask']}")
    print(f"    XPS source cpus         {r['xps_source_cpus']}")
    print("\n--- LAYER 4: application contract -> /etc/lowlatency/cores.env\n")
    for line in render_cores_env(plan).splitlines():
        if line and not line.startswith("#"):
            print(f"    {line}")
    print()


def print_nic_locality(plan):
    # A plan.json written before NIC ranking existed has no locality block. Say so rather
    # than crashing: 'lltune show' against an installed plan is a debugging tool.
    loc = plan.get("nic_locality")
    if not loc:
        print("NIC locality: not in this plan - it predates NIC-distance ranking. "
              "Re-plan to get it.\n")
        return
    node_src = {
        "device": "read from the adapter",
        "no-pxm": "GUESSED - the adapter reports no NUMA node",
        "unreadable": "GUESSED - the adapter's numa_node is unreadable",
        "no-interface": "GUESSED - no primary interface found",
        "profile": "assumed by the profile, not measured",
    }.get(loc.get("nic_numa_node_source", "profile"), "unknown")
    dist_src = {"acpi-slit": "distances from the host's ACPI SLIT",
                "structural-model": "distances inferred from the topology"}[loc["source"]]
    print(f"NIC locality: primary NIC on node {loc['nic_numa_node']}  "
          f"({node_src}; {dist_src})")
    for t in loc["tiers"]:
        nodes = ", ".join(f"node{n}" for n in t["nodes"])
        dist = f"  SLIT distance {t['distance']}" if t["distance"] is not None else ""
        cores = plan["app"]["exclusive_cores_by_tier"][str(t["tier"])]
        print(f"  tier {t['tier']}  {t['label']:<24} {nodes:<34} exclusive {cores}{dist}")
    if len(loc["node_order"]) == 1:
        print("  one NUMA node: nothing to rank, and nothing the NIC's node can change")
    elif not loc["verified"]:
        print("  UNVERIFIED ranking. Run 'lltune nic --live' on a host of this shape; if the\n"
              "  adapter reports no NUMA node, measure it by pinning load to one node at a time.")
    print()


def cmd_nic(args):
    """Report which NUMA node the primary NIC actually sits on, and the resulting ranking.

    This is the command to run on first contact with a shape: AWS publishes no PCIe
    root-complex map, so the profile's nic_numa_node is an inference until a real host
    has been read.
    """
    plan = plan_for(args)
    live = getattr(args, "live", False)
    if live:
        iface = args.iface or primary_iface()
        if not iface:
            raise SystemExit("no non-loopback interface with a PCI device found")
        raw = _read(f"/sys/class/net/{iface}/device/numa_node", "")
        _, src = nic_numa_node(iface)
        print(f"primary interface        {iface}")
        print(f"  device                 {os.path.basename(os.path.realpath(f'/sys/class/net/{iface}/device'))}")
        print(f"  numa_node (raw)        {raw or '<unreadable>'}"
              + ("   <- no _PXM in firmware; falling back to node 0" if src == "no-pxm" else ""))
        print()
        dist = node_distances_live()
        if dist:
            nodes = sorted(dist)
            print("ACPI SLIT (relative distance between NUMA nodes)")
            print("        " + "".join(f"{n:>6}" for n in nodes))
            for a in nodes:
                print(f"  node{a:<3}" + "".join(f"{dist[a].get(b, '?'):>6}" for b in nodes))
            print()
    print_nic_locality(plan)
    if not live:
        print("this is the profile's model; add --live on a real host to measure it")


def current_plan(args=None):
    if PLAN_PATH.exists():
        return json.loads(PLAN_PATH.read_text())
    raise SystemExit(f"no plan at {PLAN_PATH}; run 'lltune plan --live -o {PLAN_PATH}' first")


# ---------------------------------------------------------------- validate

class Checks:
    def __init__(self):
        self.rows = []

    def add(self, ok, name, detail=""):
        self.rows.append((ok, name, detail))

    def report(self, quiet=False):
        sym = {True: "PASS", False: "FAIL", None: "WARN"}
        width = max(len(n) for _, n, _ in self.rows)
        for ok, name, detail in self.rows:
            if quiet and ok is True:
                continue
            print(f"[{sym[ok]}] {name:<{width}}  {detail}")
        failed = sum(1 for ok, _, _ in self.rows if ok is False)
        warned = sum(1 for ok, _, _ in self.rows if ok is None)
        print(f"\n{len(self.rows)} checks, {failed} failed, {warned} warnings")
        return 1 if failed else 0


def cmd_validate(args):
    plan = json.loads(Path(args.plan).read_text()) if args.plan else current_plan()
    c = Checks()
    cmdline = _read("/proc/cmdline", "")
    iso_want = set(expand(plan["isolated_cpus"]))
    hk_want = set(expand(plan["irq_landing_cpus"]))

    # --- boot layer -------------------------------------------------------
    smt = _read("/sys/devices/system/cpu/smt/control", "notsupported")
    c.add(smt in ("off", "forceoff", "notsupported", "notimplemented"),
          "smt disabled", f"smt/control={smt}")

    online = set(expand(_read("/sys/devices/system/cpu/online", "")))
    c.add(online == set(expand(plan["isolated_cpus"]) + expand(plan["non_isolated_cpus"])),
          "online cpus match plan",
          f"{len(online)} online, {len(iso_want) + len(expand(plan['non_isolated_cpus']))} planned")

    iso_have = set(expand(_read("/sys/devices/system/cpu/isolated", "")))
    c.add(iso_have == iso_want, "isolcpus active",
          f"{compress(iso_have) or '<empty>'}" + ("" if iso_have == iso_want else f" != planned {plan['isolated_cpus']}"))

    nohz = set(expand(_read("/sys/devices/system/cpu/nohz_full", "").replace("(null)", "")))
    c.add(nohz == iso_want, "nohz_full active", compress(nohz) or "<empty>")

    c.add("rcu_nocbs=" in cmdline, "rcu_nocbs on cmdline")
    c.add("managed_irq" in cmdline, "isolcpus=managed_irq set",
          "steers managed (ENA/NVMe) IRQs off isolated cores")

    nb = _read("/proc/sys/kernel/numa_balancing", "0")
    c.add(nb == "0", "numa_balancing off", f"kernel.numa_balancing={nb}")

    # A plan built from the wrong NUMA assumption is silently wrong: the core counts look
    # plausible, but housekeeping and IRQ cores land in the wrong memory domains. Under
    # SNC3 a Xeon 6 socket is 3 NUMA nodes, not 1 - getting that wrong is a 3x error in
    # how many cores the platform reserves.
    live_nodes = len(glob.glob("/sys/devices/system/node/node[0-9]*"))
    want_nodes = plan["topology"]["numa_nodes"]
    c.add(live_nodes == want_nodes, "NUMA node count matches plan",
          f"host has {live_nodes}, plan assumes {want_nodes}"
          + ("" if live_nodes == want_nodes
             else " - REPLAN with --live; the profile's numa_nodes is wrong"))

    for nd in sorted(glob.glob("/sys/devices/system/node/node[0-9]*")):
        node = int(re.search(r"node(\d+)$", nd).group(1))
        planned = next((n for n in plan["nodes"] if n["node"] == node), None)
        if planned is None:
            continue
        live_cpus = set(expand(_read(f"{nd}/cpulist", "")))
        planned_cpus = set()
        for role in ("housekeeping", "irqnet", "shared", "exclusive"):
            planned_cpus |= set(expand(planned[role]["cpus"]))
        stray = planned_cpus - live_cpus
        c.add(not stray, f"node{node} plan cpus are node-local",
              f"{compress(stray)} planned on node{node} but live elsewhere" if stray else "clean")

    # The whole point of ranking nodes by NIC distance is lost if the plan guessed the
    # wrong node: tier 0 then names cores that are a die crossing or a UPI hop away from
    # the adapter, and every ranked list downstream is upside down.
    loc = plan.get("nic_locality", {})
    if loc:
        iface = primary_iface()
        node, src = nic_numa_node(iface)
        if src != "device":
            c.add(None, "primary NIC NUMA node",
                  f"{iface or 'no iface'}: {src} - plan assumes node "
                  f"{loc['nic_numa_node']}, unverifiable on this host")
        else:
            ok = node == loc["nic_numa_node"]
            c.add(ok, "primary NIC NUMA node matches plan",
                  f"{iface} on node {node}, plan assumes {loc['nic_numa_node']}"
                  + ("" if ok else " - REPLAN with --live; the NIC-distance ranking is wrong"))

    # --- cgroup layer -----------------------------------------------------
    cg = "/sys/fs/cgroup"
    c.add(os.path.exists(f"{cg}/cgroup.controllers"), "cgroup v2 unified hierarchy")
    subtree = _read(f"{cg}/cgroup.subtree_control", "")
    c.add("cpuset" in subtree, "cpuset controller delegated", subtree)

    for slice_name, want in (("system.slice", plan["roles"]["housekeeping"]["cpus"]),
                             ("irqnet.slice", plan["roles"]["irqnet"]["cpus"]),
                             ("pulsar.slice", plan["roles"]["exclusive"]["cpus"])):
        have = _read(f"{cg}/{slice_name}/cpuset.cpus.effective", "")
        c.add(set(expand(have)) == set(expand(want)) if have else False,
              f"{slice_name} cpuset", f"{have or '<missing>'} (want {want})")

    # --- irq layer --------------------------------------------------------
    leaked = []
    for irq_dir in sorted(glob.glob("/proc/irq/[0-9]*")):
        eff = _read(f"{irq_dir}/effective_affinity_list", "")
        if not eff:
            continue
        bad = set(expand(eff)) & iso_want
        if bad:
            names = ",".join(os.path.basename(p) for p in glob.glob(f"{irq_dir}/*")
                             if os.path.isdir(p)) or "?"
            leaked.append(f"irq{os.path.basename(irq_dir)}({names}):{compress(bad)}")
    c.add(not leaked, "no IRQ lands on an isolated cpu",
          "; ".join(leaked[:6]) + (f" (+{len(leaked) - 6} more)" if len(leaked) > 6 else "") or "clean")

    dflt = _read("/proc/irq/default_smp_affinity", "")
    c.add(bool(dflt), "default_smp_affinity set", dflt)

    # --- runtime layer ----------------------------------------------------
    thp = _read("/sys/kernel/mm/transparent_hugepage/enabled", "")
    c.add("[never]" in thp, "THP never", thp)

    govs = {_read(g, "") for g in glob.glob("/sys/devices/system/cpu/cpu*/cpufreq/scaling_governor")}
    c.add(govs <= {"performance"} if govs else None, "cpufreq governor performance",
          ",".join(sorted(govs)) or "no cpufreq driver (fixed frequency)")

    wq = _read("/sys/devices/virtual/workqueue/cpumask", "")
    wq_cpus = set(expand(compress(_mask_to_cpus(wq)))) if wq else set()
    c.add(not (wq_cpus & iso_want) if wq else None, "unbound workqueues off isolated cpus",
          f"cpumask={wq} -> {compress(wq_cpus)}")

    wb = _read("/sys/bus/workqueue/devices/writeback/cpumask", "")
    if wb:
        wb_cpus = set(_mask_to_cpus(wb))
        c.add(not (wb_cpus & iso_want), "writeback workqueue off isolated cpus", compress(wb_cpus))

    ts = _read("/proc/sys/kernel/timer_migration", "1")
    c.add(ts == "0", "timer_migration off", f"kernel.timer_migration={ts}")

    wd = _read("/proc/sys/kernel/watchdog", "1")
    c.add(wd == "0", "soft/hard lockup watchdog off", f"kernel.watchdog={wd}")

    iface = primary_iface()
    if iface:
        try:
            ch = subprocess.run(["ethtool", "-l", iface], capture_output=True, text=True, timeout=5).stdout
            cur = re.search(r"Current hardware settings:.*?Combined:\s*(\d+)", ch, re.S)
            n = int(cur.group(1)) if cur else -1
            want = len(expand(plan["roles"]["irqnet"]["cpus"]))
            c.add(n <= want if n > 0 else None, f"{iface} combined queues <= irqnet cores",
                  f"combined={n}, irqnet cores={want}")
        except Exception as e:
            c.add(None, f"{iface} queue count", f"ethtool unavailable: {e}")

    # --- stray tasks on isolated cores ------------------------------------
    strays = _tasks_on(iso_want)
    c.add(not strays, "no unexpected tasks on isolated cpus",
          ", ".join(strays[:8]) + (f" (+{len(strays) - 8})" if len(strays) > 8 else "") or "clean")

    return c.report(args.quiet)


def _mask_to_cpus(mask):
    mask = mask.replace(",", "")
    try:
        v = int(mask, 16)
    except ValueError:
        return []
    return [i for i in range(v.bit_length()) if v >> i & 1]


def _tasks_on(iso):
    """Userspace tasks currently pinned onto isolated cpus that are not in a pulsar slice."""
    out = []
    for p in glob.glob("/proc/[0-9]*"):
        try:
            pid = os.path.basename(p)
            stat = Path(p, "stat").read_text().rsplit(") ", 1)[1].split()
            cpu = int(stat[36])  # last-run processor
            if cpu not in iso:
                continue
            cg = Path(p, "cgroup").read_text()
            if "pulsar" in cg:
                continue
            comm = Path(p, "comm").read_text().strip()
            if comm.startswith(("swapper", "cpuhp/", "idle_inject", "migration/")):
                continue
            out.append(f"{comm}[{pid}]@cpu{cpu}")
        except (OSError, IndexError, ValueError):
            continue
    return sorted(set(out))


# ---------------------------------------------------------------- cli

def main():
    ap = argparse.ArgumentParser(prog="lltune", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def src(p):
        g = p.add_mutually_exclusive_group()
        g.add_argument("--profile", help="planning profile name or path")
        g.add_argument("--live", action="store_true", help="read the real topology from sysfs")

    p = sub.add_parser("topology", help="show discovered or synthesised topology")
    src(p); p.add_argument("-v", "--verbose", action="store_true"); p.set_defaults(fn=cmd_topology)

    p = sub.add_parser("plan", help="compute the core plan")
    src(p)
    p.add_argument("--policy"); p.add_argument("-o", "--out")
    p.add_argument("--shared-ratio", type=float, dest="shared_ratio")
    p.add_argument("--hugepages-1g-per-node", type=int, dest="hugepages_1g_per_node")
    p.add_argument("--mitigations-off", action="store_true", default=None, dest="mitigations_off")
    p.add_argument("--idle-poll", action="store_true", default=None, dest="idle_poll")
    p.set_defaults(fn=cmd_plan)

    p = sub.add_parser("show", help="human-readable core map")
    src(p); p.add_argument("--plan"); p.add_argument("--policy"); p.set_defaults(fn=cmd_show)

    p = sub.add_parser("render", help="render grub / slices / cores.env from a plan")
    src(p); p.add_argument("--plan"); p.add_argument("-o", "--out", default="./out")
    p.set_defaults(fn=cmd_render)

    p = sub.add_parser("layers", help="dump every config layer for a profile")
    src(p); p.add_argument("--plan"); p.add_argument("--policy")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.set_defaults(fn=cmd_layers)

    p = sub.add_parser("nic", help="which NUMA node the primary NIC is on, and the node ranking")
    src(p); p.add_argument("--plan"); p.add_argument("--policy")
    p.add_argument("--iface", help="interface to inspect (default: first non-loopback)")
    p.set_defaults(fn=cmd_nic)

    p = sub.add_parser("validate", help="verify the running host matches the plan")
    p.add_argument("--plan"); p.add_argument("-q", "--quiet", action="store_true",
                                             help="only show failures and warnings")
    p.set_defaults(fn=cmd_validate)

    args = ap.parse_args()
    if not hasattr(args, "live"):
        args.live = False
    sys.exit(args.fn(args) or 0)


if __name__ == "__main__":
    main()
